# ==============================================================================
# NEURODESK AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to backend/.env before running Uvicorn server or pytest.
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="NeuroDesk AI"
VERSION=1.0.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

SECRET_KEY=replace_with_secure_jwt_secret_key_neurodesk_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite+aiosqlite:///./neurodesk.db

STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_TEMP_DIR=storage/temp
DEFAULT_STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_BYTES=104857600

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash