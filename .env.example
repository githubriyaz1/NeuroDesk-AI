# ==============================================================================
# NEURODESK AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' inside the backend/ directory or root directory before starting.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION (Mandatory)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="NeuroDesk AI"
VERSION=1.0.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION (Mandatory - Replace in Production!)
# ------------------------------------------------------------------------------
# WARNING: Change JWT_SECRET / SECRET_KEY to a secure 256-bit random key in production!
SECRET_KEY=replace_with_secure_jwt_secret_key_neurodesk_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Mandatory)
# ------------------------------------------------------------------------------
# Development default: SQLite (in-memory or file-backed)
DATABASE_URL=sqlite+aiosqlite:///./neurodesk.db
# Production recommendation: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/neurodesk_db

# ------------------------------------------------------------------------------
# 4. STORAGE & FILE PIPELINE (Mandatory)
# ------------------------------------------------------------------------------
STORAGE_LOCAL_ROOT=storage/uploads
STORAGE_TEMP_DIR=storage/temp
DEFAULT_STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB max file size limit

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Mandatory for Frontend Access)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 6. LLM ENGINE & GEMINI PROVIDER CONFIGURATION (Optional - Graceful Mock Fallback)
# ------------------------------------------------------------------------------
# Set GOOGLE_API_KEY to enable official Google Gemini API integration.
# If omitted or unconfigured, NeuroDesk AI automatically degrades gracefully to MockProvider.
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_PROVIDER=gemini  # 'gemini' or 'mock'
LLM_MODEL=gemini-2.5-flash
